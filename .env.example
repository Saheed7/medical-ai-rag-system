# ---------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------

# Hugging Face access token (required).
# Create one at https://huggingface.co/settings/tokens  (role: read)
HF_TOKEN=hf_your_token_here

# ---- Application ----
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8080

# ---- Model selection ----
# Hugging Face routes chat requests through third-party inference providers.
# Leaving LLM_PROVIDER unset ("auto") lets HF choose, but provider coverage
# changes over time and a wrong choice surfaces as a confusing 404.
# Run `python scripts/check_llm.py` to discover a working combination.
LLM_REPO_ID=meta-llama/Llama-3.1-8B-Instruct
LLM_PROVIDER=novita
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# ---- Retrieval tuning ----
RETRIEVAL_TOP_K=4
RETRIEVAL_STRATEGY=similarity
CHUNK_SIZE=800
CHUNK_OVERLAP=120
